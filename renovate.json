{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"semanticCommits": "enabled",
	"schedule": ["before 6am on monday"],
	"pre-commit": { "enabled": true },
	"customManagers": [
		{
			"customType": "regex",
			"description": "ERPNext image the tests run on",
			"managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
			"matchStrings": ["FRAPPE_IMAGE: (?<depName>frappe/erpnext):(?<currentValue>v\\S+)"],
			"datasourceTemplate": "docker"
		}
	],
	"packageRules": [
		{
			"description": "Build tooling follows Frappe's app template (flit_core <4)",
			"matchManagers": ["pep621"],
			"enabled": false
		},
		{
			"description": "The app targets v16; a new major is a deliberate change",
			"matchPackageNames": ["frappe/erpnext"],
			"matchUpdateTypes": ["major"],
			"enabled": false
		},
		{
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions"
		}
	]
}
